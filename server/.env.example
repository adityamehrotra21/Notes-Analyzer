# ---------- Server ----------
# 5000 is taken by macOS AirPlay Receiver, so default to 5001
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
# Behind a reverse proxy/PaaS: number of proxy hops (usually 1), so rate limits see real client IPs
TRUST_PROXY=0
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access token (kept in memory by the browser) and the httpOnly refresh cookie that renews it.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# lax = client and API on the same site (Vite proxy, Vercel rewrite). none = browser calls the API on
# another domain directly (forces Secure; then also list that origin in CLIENT_ORIGIN).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true   # default: true in production

# ---------- Database (PostgreSQL + pgvector) ----------
# Local Docker (docker compose up -d):
DATABASE_URL=postgres://notes:notes@localhost:5432/notesanalyser
# auto (default): no SSL for localhost/docker, SSL (unverified) elsewhere. off | require | verify (+ DB_SSL_CA).
DB_SSL=auto
# Connections per process. Keep small on Supabase free.
DB_POOL_MAX=5
# Serve client/dist from Express (single-origin run). false when the client is on Vercel.
SERVE_CLIENT=false
# Must match chunks.embedding vector(N) in the migrations (1536 = text-embedding-3-small).
EMBED_DIMENSIONS=1536
# Uploaded PDFs are stored here (git-ignored) so documents can be re-indexed
STORAGE_DIR=storage

# ---------- Email ----------
# EMAIL_PROVIDER: brevo | resend | smtp | console. Default: smtp if SMTP_HOST is set, else console (log only).
# On Render free use brevo or resend (outbound SMTP is blocked). MAIL_FROM must be a verified sender there.
EMAIL_PROVIDER=
BREVO_API_KEY=
RESEND_API_KEY=
# Gmail SMTP (local): 1) Turn on 2-Step Verification for your Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords (16 characters, no spaces)
# Leave SMTP_HOST empty in dev to have emails written to the server log instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:5173

# ---------- Sessions ----------
MAX_SESSIONS_PER_USER=5

# Forgot password: 6-digit code sent by email
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# Signup: reject email domains that can't receive mail (DNS lookup). false for offline dev/tests.
EMAIL_DNS_CHECK=true

# ---------- Logging ----------
# debug | info | warn | error
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

# ---------- LLM provider ----------
# openai | gemini | mock
LLM_PROVIDER=openai
# true = canned offline responses for chat/summaries/quizzes AND offline embeddings: spends nothing
LLM_MOCK=false
OPENAI_API_KEY=
# Optional: any OpenAI-compatible API (e.g. https://api.groq.com/openai/v1)
OPENAI_BASE_URL=
# Main model: chat answers, quiz + question generation, final summaries
OPENAI_CHAT_MODEL=gpt-5-mini
# Cheap model: map step of map-reduce summaries and other bulk/intermediate calls
OPENAI_CHEAP_MODEL=gpt-5-nano
OPENAI_EMBED_MODEL=text-embedding-3-small
# Reasoning effort (billed as output tokens): main model (gpt-5-mini) and cheap model (gpt-5-nano). none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
OPENAI_REASONING_EFFORT_CHEAP=minimal

# Gemini (only for LLM_PROVIDER=gemini / EMBED_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBED_MODEL=
GEMINI_THINKING_BUDGET=

# ---------- Budget (enforced in code; prices in src/config/pricing.js) ----------
# Hard cap on total OpenAI spend by this app, in USD. Calls that could exceed it are refused (HTTP 402).
LLM_BUDGET_USD=1.20
# Warn (log + banner) once spend passes this percentage
BUDGET_WARN_PCT=75

# ---------- Output caps per feature (tokens; reasoning tokens count) ----------
MAX_OUTPUT_TOKENS_CHAT=2000
MAX_OUTPUT_TOKENS_QUESTIONS=4000
MAX_OUTPUT_TOKENS_QUIZ=4000
MAX_OUTPUT_TOKENS_SUMMARY_MAP=1500
MAX_OUTPUT_TOKENS_SUMMARY_REDUCE=4000
# Document-wide chat answers ("explain my notes in detail") and the intent classifier
MAX_OUTPUT_TOKENS_CHAT_LONG=2000
# Detailed Notes / Exam Revision, missing-topic fill, and the topic outline (nano)
MAX_OUTPUT_TOKENS_NOTES=12000
MAX_OUTPUT_TOKENS_NOTES_FILL=4000
MAX_OUTPUT_TOKENS_OUTLINE=2000
MAX_OUTPUT_TOKENS_CLASSIFY=200
MAX_OUTPUT_TOKENS_OCR=3000
# Diagram/scanned pages per document sent to the vision model (about $0.001-0.003 each).
VISION_MAX_PAGES=30
LLM_MAX_CONTEXT_TOKENS=400000

# ---------- Context sizes (cost control) ----------
CHAT_TOP_K=5
CHAT_HISTORY_TURNS=4
CHAT_CONTEXT_TOKENS=6000
# Document-wide chat questions send the whole document if it is at most this many tokens
CHAT_FULLDOC_TOKENS=30000
GENERATION_CONTEXT_TOKENS=8000
# Documents up to this size are summarised in ONE call to OPENAI_CHAT_MODEL; larger ones use map-reduce
SUMMARY_SINGLE_CALL_TOKENS=60000
SUMMARY_GROUP_TOKENS=8000

# ---------- Embeddings ----------
# openai | gemini | hash ("hash" = offline lexical embeddings for testing; not for real use)
EMBED_PROVIDER=openai
EMBED_BATCH_SIZE=256

# ---------- Pacing (requests/tokens per minute; set to your tier) ----------
EMBED_RPM=500
EMBED_TPM=900000
LLM_RPM=60
LLM_TPM=200000
LLM_CONCURRENCY=2
